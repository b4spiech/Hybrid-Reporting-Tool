# Copy to .env for local development. Never commit your real .env.
# On Railway these are set as service variables instead.

# Postgres connection string. Railway's Postgres plugin provides DATABASE_URL
# automatically; reference it in this service's variables as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://user:password@localhost:5432/gantt

# SSL policy (optional). Auto by default: off for localhost / *.railway.internal,
# on (relaxed) for public hosts. Force with: true | require | false | disable
# DATABASE_SSL=

# Port the server listens on. Railway sets PORT automatically; 8787 for local dev.
PORT=8787

# Basic-auth gate. If BOTH are set, every route (UI + /api) requires these
# credentials. If unset, access is open (intended for local dev only).
APP_USER=
APP_PASSWORD=

# Service-token credentials for the machine-to-machine routes: the ADO ingest
# route (PUT /api/projects/:id/rows) and the manual sync trigger (POST /api/sync).
# Callers must send matching CF-Access-Client-Id / CF-Access-Client-Secret headers.
# If unset, those routes are disabled (fail closed). Names only — never commit values.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# App-owned Azure DevOps sync (pulls work items from ADO Analytics on a schedule).
# Required to enable syncing; if ADO_PAT or ADO_ORG is unset, sync is disabled.
ADO_PAT=                 # Azure DevOps PAT, Analytics (Read) scope
ADO_ORG=                 # org name, e.g. TKG-PMO
ADO_PROJECTS=            # optional CSV of ADO project names; empty = all the feed returns
ADO_SYNC_CRON=0 * * * *  # optional cron expression; default hourly
