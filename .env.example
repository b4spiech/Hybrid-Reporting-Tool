# Copy to .env for local development. Never commit your real .env.
# On Railway these are set as service variables instead.

# Postgres connection string. Railway's Postgres plugin provides DATABASE_URL
# automatically; reference it in this service's variables as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://user:password@localhost:5432/gantt

# SSL policy (optional). Auto by default: off for localhost / *.railway.internal,
# on (relaxed) for public hosts. Force with: true | require | false | disable
# DATABASE_SSL=

# Port the server listens on. Railway sets PORT automatically; 8787 for local dev.
PORT=8787

# Basic-auth gate. If BOTH are set, every route (UI + /api) requires these
# credentials. If unset, access is open (intended for local dev only).
APP_USER=
APP_PASSWORD=

# Service-token credentials for the ADO ingest route (PUT /api/projects/:id/rows).
# Power Automate must send matching CF-Access-Client-Id / CF-Access-Client-Secret
# headers. If unset, the ingest route is disabled (fails closed). Names only —
# never commit real values.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
