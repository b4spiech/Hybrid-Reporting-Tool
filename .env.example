# Copy to .env for local development. Never commit your real .env.
# On Railway these are set as service variables instead.

# Postgres connection string. Railway's Postgres plugin provides DATABASE_URL
# automatically; reference it in this service's variables as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://user:password@localhost:5432/gantt

# SSL policy (optional). Auto by default: off for localhost / *.railway.internal,
# on (relaxed) for public hosts. Force with: true | require | false | disable
# DATABASE_SSL=

# Port the server listens on. Railway sets PORT automatically; 8787 for local dev.
PORT=8787

# Basic-auth gate. If BOTH are set, every route (UI + /api) requires these
# credentials. If unset, access is open (intended for local dev only).
APP_USER=
APP_PASSWORD=

# Service-token credentials for the machine-to-machine routes: the ADO ingest
# route (PUT /api/projects/:id/rows), the manual sync trigger (POST /api/sync), and
# the LLM verify endpoint (POST /api/llm/ping). Callers must send matching
# CF-Access-Client-Id / CF-Access-Client-Secret headers. If unset, those routes are
# disabled (fail closed). Names only — never commit values.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# LLM provider (switchable; the app depends only on the provider interface).
# LLM_PROVIDER selects the adapter: anthropic | azure-openai | ollama | copilot-studio
LLM_PROVIDER=ollama
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6   # optional; defaults to a current Claude model
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=              # e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=            # deployment name
AZURE_OPENAI_API_VERSION=          # e.g. 2024-02-15-preview
# Ollama
OLLAMA_BASE_URL=http://localhost:11434  # optional; this is the default
OLLAMA_MODEL=                      # e.g. llama3.1

# App-owned Azure DevOps sync (pulls work items from ADO Analytics on a schedule).
# Required to enable syncing; if ADO_PAT or ADO_ORG is unset, sync is disabled.
ADO_PAT=                 # Azure DevOps PAT, Analytics (Read) + Work Items (Read) scope
ADO_WORK_PAT=            # optional; PAT for the Work REST API (team capacity); falls back to ADO_PAT
ADO_ORG=                 # org name, e.g. TKG-PMO
ADO_PROJECTS=            # optional CSV of ADO project names; empty = all the feed returns
ADO_SYNC_CRON=0 * * * *  # optional cron expression; default hourly
ADO_ITEM_TYPE=Feature    # optional work-item type to display/roll up; default Feature
